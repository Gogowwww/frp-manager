# ── Données sensibles frp / panel (ne JAMAIS committer) ───────────────────────
# Configs réelles (tokens, IP, domaines)
*.toml
*.ini
frp-manager.json
*.local.*

# Certificats / clés
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Logs et état runtime
*.log
state.json
/var/

# Secrets divers
.env
.env.*
secrets*
*.secret

# ── Construction Go / Go build ───────────────────────────────────────────────
# Programme construit à la racine (go build -o frp-manager ./panel), sorties
# de la CI reproduites en local (dist/, ci/), binaires de test et couverture.
# Program built at the root (go build -o frp-manager ./panel), CI outputs
# reproduced locally (dist/, ci/), test binaries and coverage.
/frp-manager
*.exe
*.test
/coverage.out
/dist/
/ci/

# ── Python (passerelle packaging/python-bridge) ──────────────────────────────
__pycache__/
*.py[cod]

# ── Agents de code / Coding agents ───────────────────────────────────────────
# Consignes locales des agents, hors du dépôt public : docs/CONTRIBUTING.md
# reste la référence.
# Local agent instructions, kept out of the public repository:
# docs/CONTRIBUTING.md remains the reference.
/AGENTS.md
/CLAUDE.md
/.claude/

# ── OS / éditeurs ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
